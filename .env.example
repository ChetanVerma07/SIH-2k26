# Canonical development configuration
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/passive_shelter
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/passive_shelter_test
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK_API=false

# Optional external weather integration. The current climate service falls back
# to the bundled preset data when these values are not configured.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=

# Optional ANSYS integration. The current backend reports ANSYS as unavailable
# unless a future adapter is configured with these values.
ANSYS_EXECUTABLE_PATH=
ANSYS_WORKING_DIRECTORY=
