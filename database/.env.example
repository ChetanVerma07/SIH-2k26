# PostgreSQL connection string used by the app and Alembic.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/passive_shelter

# Optional: separate URL used only by the test suite.
# If unset, tests fall back to DATABASE_URL with "_test" appended to the db name.
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/passive_shelter_test

SQL_ECHO=false
